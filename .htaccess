

###############################################################

RewriteEngine on
IndexIgnore *
Options +FollowSymLinks -Multiviews -Indexes
####Uncomment for Production SSL####
#RewriteCond %{HTTPS} off
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

###############################################################

## MODERN CACHING STRATEGY ##

# Cache-Control Headers (Modern Standard)
<IfModule mod_headers.c>
    # Static assets with long cache (1 year)
    <FilesMatch "\.(jpg|jpeg|gif|png|ico|svg|webp|woff|woff2|eot|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # CSS and JavaScript (1 year, immutable for versioned files)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # HTML and PHP (1 hour, always validate with server)
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Fallback for older browsers and servers without mod_headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/html "access plus 1 week"
    ExpiresDefault "access plus 1 week"
</IfModule>

###############################################################



###############################################################

#change file extensions

RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php

RewriteCond %{REQUEST_FILENAME}\.htm -f
RewriteRule ^(.*)$ $1.htm

# Force HTTPS (uncomment for production only)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www or non-www (uncomment for production only)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ http://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

###############################################################

ErrorDocument 404 /404.php

###############################################################

#301 Redirect for sunset pages
Redirect 301 /black-ski-weekend /urban-ski-weekend
Redirect 301 /ciaa /the-tourney
Redirect 301 /macys-music-festival /nati-music-festival
Redirect 301 /urban /urban-fiesta-jamaica
Redirect 301 /nba-allstar /allstar-weekend
Redirect 301 /allstar /allstar-weekend
